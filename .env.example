# ELORA — copy to backend/.env and frontend/.env, replace placeholders.
# NEVER commit a real .env. Generate secrets with: openssl rand -hex 32

# ---- backend/.env ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/elora
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/elora
# (Append the DB name to the srv string. Password may need URL-encoding if it has special chars.)
JWT_ACCESS_SECRET=REPLACE_WITH_32_CHAR_RANDOM
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_RANDOM
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_ORIGIN=http://localhost:5173
WORLD_DAY_SECONDS=600

# ---- frontend/.env (public by design — never put secrets here) ----
VITE_API_URL=http://localhost:4000
